&inputs
    NI =27
    NJ = 97
    p0 = 65.8558 !2                                                     !kpa
    T0 = 300                                                       !K
    Ru = 8314
    M = 28.97 
    CFL = .1
    gamma = 1.4
    artifial_dissapation = .false.
    extrapolation_order = 0
    epsilon = .00001
    kappa = -1
    upwind_order = 0 ! 1 for first order 1 for second order
    convergence_criteria = 1e-12
    damping_scheme = 1 !  1 for van leer upwind, 2 for roe upwind
    iter_max = 1000000
    local_timestep = .true.
    flux_limiter_scheme = 1 ! 0 for freeze, 1 for van leer, 2 for van albada

    


