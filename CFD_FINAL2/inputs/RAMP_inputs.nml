&inputs
    NI =17
    NJ = 53
    p0 = 65.8558 !2                                                     !kpa
    T0 = 300                                                       !K
    Ru = 8314
    M = 28.97 
    p_inf = 1 !kpa
    T_inf = 1 !K
    CFL = .1
    ghost_cells = 1
    domain = 0,6
    p_back =  -1
    gamma = 1.4
    artifial_dissapation = .false.
    K4 = .02
    K2 = .35
    compute_isentropic = .true.
    extrapolation_order = 0
    epsilon = .00001
    kappa = -1
    upwind_order = 0 ! 1 for first order 1 for second order
    convergence_criteria = 1e-12
    damping_scheme =4 ! 0 for jameson damping, 1 for van leer upwind, 2 for roe upwind
    iter_max = 1000000
    local_timestep = .true.
    flux_limiter_scheme = 1 ! 0 for freeze, 1 for van leer, 2 for van albada
    flat_initial_mach = .false.
    converge_at_second_order = -1 !-1 for none and 1e-7 for switch
    return_conserved = .false.
    


/